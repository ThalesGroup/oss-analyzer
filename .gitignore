# Reports generated by analyze-archive.sh / the CI pipeline — bulky,
# reproducible on demand, never to be versioned.
security-reports/
data/test/reports/

# Test archives dropped in manually during development — not project
# fixtures, not to be versioned (large binaries, would need Git LFS otherwise).
data/test/*.zip
data/test/*.tar.gz

# Local machine Claude Code config — never to be shared as-is.
# settings.json allowed Bash(*) with no restriction (full permission, no
# confirmation, for anyone who clones this repo): never commit it as
# is. Everyone keeps their own permissions locally.
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python
__pycache__/
*.pyc

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
